    "### Dataset #1 \n",
    "\n",
    "import matplotlib.pyplot as plt

# ----------------------------
# 1) Merge: keep only common metropolitan areas
# ----------------------------
# Assumes you have two separate dataframes:
#   df_income: has columns like ["NAME", "median_income", ...]
#   df_home:   has columns like ["NAME", "median_home_value", ...]
# If your home-value dataframe is named differently (e.g., df_home_value), just swap it in.

merged_df = df_income.merge(df_home, on="NAME", how="inner")

# If both dataframes contain overlapping column names (other than NAME),
# pandas will suffix them with _x and _y. This block cleans that up.
merged_df = merged_df.rename(columns={
    "median_income_x": "median_income",
    "median_income_y": "median_income",
    "median_home_value_x": "median_home_value",
    "median_home_value_y": "median_home_value",
    "population_x": "population",
    "population_y": "population",
    "unemployment_rate_x": "unemployment_rate",
    "unemployment_rate_y": "unemployment_rate",
})

# Optional: keep only the columns you need for downstream analysis
cols_to_keep = [c for c in ["NAME", "median_income", "median_home_value", "population", "unemployment_rate"] if c in merged_df.columns]
merged_df = merged_df[cols_to_keep].copy()

# Optional: drop rows missing key variables
key_vars = [c for c in ["median_income", "median_home_value"] if c in merged_df.columns]
merged_df_clean = merged_df.dropna(subset=key_vars).copy()

# ----------------------------
# 2) Plot: missingness, boxplots, histograms (using merged data)
# ----------------------------
fig, axes = plt.subplots(2, 2, figsize=(10, 8))

# 1) Missingness per column (merged data)
missing = merged_df_clean.isna().sum()
axes[0, 0].bar(missing.index, missing.values, color='steelblue', edgecolor='black')
axes[0, 0].set_ylabel("Missing count")
axes[0, 0].set_title("Missing values by column (merged)")
axes[0, 0].tick_params(axis='x', rotation=45)

# 2) Boxplots for numeric variables (show spread and outliers)
numeric_cols = [c for c in ["median_income", "median_home_value", "population"] if c in merged_df_clean.columns]
merged_df_clean[numeric_cols].boxplot(ax=axes[0, 1], patch_artist=True)
axes[0, 1].set_ylabel("Value")
axes[0, 1].set_title("Distributions and outliers (IQR)")
axes[0, 1].tick_params(axis='x', rotation=15)

# 3) Histogram of median_income
axes[1, 0].hist(merged_df_clean["median_income"], bins=30, color='steelblue', edgecolor='white')
axes[1, 0].set_xlabel("Median household income ($)")
axes[1, 0].set_ylabel("Count")
axes[1, 0].set_title("Median income distribution")

# 4) Histogram of median_home_value
axes[1, 1].hist(merged_df_clean["median_home_value"], bins=30, color='coral', edgecolor='white')
axes[1, 1].set_xlabel("Median home value ($)")
axes[1, 1].set_ylabel("Count")
axes[1, 1].set_title("Median home value distribution")

plt.tight_layout()
plt.show()"
